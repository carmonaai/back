# The `fleet` profile: a simulated engine fleet behind the stand-in, several gateway and inference replicas.
#   docker compose --env-file .env --env-file fleet.env --profile fleet up -d --build --wait
# (the second --env-file wins; .env keeps the secrets, this file has none.) Docker picks the gateways' host ports from
# the range (`docker compose ps` shows them); scripts on the compose network use http://gateway:8080.
# Sizes: the prototype's ceiling on the 8 GB Docker VM was 3 gateways + 3 inference + 8 simulators (4.9 GB, about 1.1 GB
# free) WITHOUT Prometheus and Grafana (about 0.9 GB of limits); this compose has them, so the largest size that fits is
# the scorecard's to find (H3). Each simulator costs ~15 MiB. ENGINE_SLOTS / ENGINE_QUEUE are the fleet sums: 4 running
# and 2 queued per simulator, so inference-service's admission (not the simulators' own queue of 8) refuses traffic
# beyond capacity.
ENGINE_REPLICAS=8
INFERENCE_REPLICAS=3
GATEWAY_REPLICAS=3
GATEWAY_PORTS=127.0.0.1:8080-8089:8080
ENGINE_URL=http://engine-lb:8000
ENGINE_SLOTS=32
ENGINE_QUEUE=16
