{
  "uid": "carmona-slo",
  "title": "Carmona — SLO & golden signals",
  "description": "Availability, traffic, errors and the inference latency SLOs (TTFT p95 <= 2 s, ITL p95 <= 100 ms; inference-plan.md §8). Panels reading carmona_inference_* are empty until task A publishes those metrics (see references/observability.md §gaps).",
  "tags": ["carmona", "slo"],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "job",
        "label": "service",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "query": {"query": "label_values(http_server_requests_seconds_count, job)", "refId": "service"},
        "definition": "label_values(http_server_requests_seconds_count, job)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "sort": 1,
        "current": {"selected": true, "text": ["All"], "value": ["$__all"]}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Availability and traffic",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Availability (last scrape)",
      "description": "SLO: every target UP. A failed scrape is blindness, not a percentage — there is no numeric availability SLO yet (plan §8 leaves it per model class, unset). 1 = UP, 0 = DOWN for 2 minutes (see the ServiceDown alert).",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 1},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]},
          "color": {"mode": "thresholds"}
        },
        "overrides": []
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name"},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "max by (job) (up{job=~\"$job\"})", "legendFormat": "{{job}}", "editorMode": "code", "range": true}
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Request rate by service",
      "description": "Traffic (the R in RED). Every service's own HTTP server metric; the management port's /actuator/prometheus requests are in here too and are the only traffic on an idle stack.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 1},
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 8, "showPoints": "never"},
          "color": {"mode": "palette-classic"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (job) (rate(http_server_requests_seconds_count{job=~\"$job\"}[$__rate_interval]))", "legendFormat": "{{job}}", "editorMode": "code", "range": true}
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Error share (5m)",
      "description": "SLO: below 5% (the line on the panel; the ErrorShareHigh alert fires above it for 5m). 5xx only — a 4xx is a client mistake or a business answer (402 out of credit, 429 a refusal) and is charted on the revenue dashboard instead.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 1},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 8, "showPoints": "never"},
          "color": {"mode": "palette-classic"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.05}]}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (job) (rate(http_server_requests_seconds_count{job=~\"$job\", outcome=\"SERVER_ERROR\"}[5m])) / sum by (job) (rate(http_server_requests_seconds_count{job=~\"$job\"}[5m]))", "legendFormat": "{{job}}", "editorMode": "code", "range": true}
      ]
    },
    {
      "id": 5,
      "type": "row",
      "title": "Inference latency (the SLOs)",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 7},
      "panels": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "TTFT p50 / p95 / p99",
      "description": "SLO: p95 at or below 2 s (phase-3 bench on the RTX 3050: C = 4 holds TTFT p95 at 0.8 s; the line on the panel is 2 s). Needs carmona_inference_ttft_seconds — NOT PUBLISHED YET (task A).",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 8, "showPoints": "never"},
          "color": {"mode": "palette-classic"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 2}]}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"refId": "p50", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.50, sum by (le) (rate(carmona_inference_ttft_seconds_bucket[$__rate_interval])))", "legendFormat": "p50", "editorMode": "code", "range": true},
        {"refId": "p95", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.95, sum by (le) (rate(carmona_inference_ttft_seconds_bucket[$__rate_interval])))", "legendFormat": "p95 (SLO 2 s)", "editorMode": "code", "range": true},
        {"refId": "p99", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.99, sum by (le) (rate(carmona_inference_ttft_seconds_bucket[$__rate_interval])))", "legendFormat": "p99", "editorMode": "code", "range": true}
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "TTFT goodput (5m)",
      "description": "SLO: at least 95% of requests get their first token within 2 s — the share the phase-4 and phase-5 exit checks demand (enterprise goodput >= 95%). Recorded as ttft:goodput_5m. Needs carmona_inference_ttft_seconds — NOT PUBLISHED YET (task A).",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 2,
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 0.95}, {"color": "green", "value": 0.99}]},
          "color": {"mode": "thresholds"}
        },
        "overrides": []
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "area", "textMode": "value_and_name"},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "ttft:goodput_5m", "legendFormat": "{{model}} {{tier}}", "editorMode": "code", "range": true}
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Inter-token latency p95",
      "description": "SLO: p95 at or below 100 ms (TPOT; phase-3 bench measured 24 ms at C = 4, and 100 ms is what the goodput definition allows). The line on the panel is 0.1 s. Needs carmona_inference_itl_seconds — NOT PUBLISHED YET (task A).",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 16},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 8, "showPoints": "never"},
          "color": {"mode": "palette-classic"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.1}]}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "itl:p95_5m", "legendFormat": "{{model}} {{tier}}", "editorMode": "code", "range": true}
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Queue wait p95 (request understood → engine start)",
      "description": "The time from a request being understood to its engine call starting: the rate-bucket script, a paying tier's wait for a free slot (at most 1.5 s, then the 429) and the lease script. Only requests that reached the engine are in it. The QueueWaitHigh alert fires when a model and tier stay above the red line, 1 s, for 10 minutes: capacity if the engine is busy, Valkey if it is idle. Before the pipeline change it started when the lease was taken and read about zero.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 16},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 8, "showPoints": "never"},
          "color": {"mode": "palette-classic"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.95, sum by (le, model, tier) (rate(carmona_inference_queue_wait_seconds_bucket[5m])))", "legendFormat": "{{model}} {{tier}}", "editorMode": "code", "range": true}
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Whole request p95 / p99",
      "description": "No latency SLO for the whole request: the hard ceiling is the gateway's 660 s route timeout on /v1 (compose of the code's 600 s response timeout). Streamed answers are dominated by output length, so read it with tokens/s. Needs carmona_inference_request_seconds — NOT PUBLISHED YET (task A).",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 16},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 8, "showPoints": "never"},
          "color": {"mode": "palette-classic"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"refId": "p95", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.95, sum by (le) (rate(carmona_inference_request_seconds_bucket[$__rate_interval])))", "legendFormat": "p95", "editorMode": "code", "range": true},
        {"refId": "p99", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.99, sum by (le) (rate(carmona_inference_request_seconds_bucket[$__rate_interval])))", "legendFormat": "p99", "editorMode": "code", "range": true}
      ]
    },
    {
      "id": 11,
      "type": "row",
      "title": "Capacity and engine saturation",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 23},
      "panels": []
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "In-flight vs capacity",
      "description": "How close each model is to what admission allows. The gap between the two lines is the reserved share of the other tiers: trial C/2, standard 85%, enterprise C + q (plan §7). Needs carmona_inference_inflight / _capacity — NOT PUBLISHED YET (task A).",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 24},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 8, "showPoints": "never"},
          "color": {"mode": "palette-classic"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"refId": "in-flight", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (model) (carmona_inference_inflight)", "legendFormat": "in-flight {{model}}", "editorMode": "code", "range": true},
        {"refId": "capacity", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (model, tier) (carmona_inference_capacity)", "legendFormat": "capacity {{model}} {{tier}}", "editorMode": "code", "range": true}
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Engine requests running / waiting",
      "description": "The engine's own view, scraped directly every 15 s (vllm:num_requests_running / vllm:num_requests_waiting, which the simulator and vLLM both report). Running is the busiest replica (engine:requests_running); waiting is all replicas added up (engine:requests_waiting_total), drawn against the queue places inference-service admits behind the slots (engine:queue_places, from carmona_engine_queue_places). The EngineQueueSustained alert fires when waiting stays at the queue-places line for 2 minutes; without that line (inference-service down) the alert is quiet.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 24},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 8, "showPoints": "never"},
          "color": {"mode": "palette-classic"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"refId": "running", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "engine:requests_running", "legendFormat": "running {{job}}", "editorMode": "code", "range": true},
        {"refId": "waiting", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "engine:requests_waiting_total", "legendFormat": "waiting {{job}} (all replicas)", "editorMode": "code", "range": true},
        {"refId": "places", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "engine:queue_places", "legendFormat": "queue places (alert line)", "editorMode": "code", "range": true}
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Engine KV cache usage",
      "description": "A 0-1 ratio: vLLM v0.30.0 reports kv_cache_usage_perc (its help text: 1 means 100 percent usage); the simulator reports the same series, at 0 unless it runs with --enable-kvcache. No threshold: the engine evicts and keeps serving, so the useful reading is the trend and where TTFT starts to climb with it.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 24},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 8, "showPoints": "never"},
          "color": {"mode": "palette-classic"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "engine:cache_usage", "legendFormat": "{{job}}", "editorMode": "code", "range": true}
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Tokens/s by mode and kind",
      "description": "What the platform is actually selling: output tokens are the billable ones, input tokens are the cached prompt work. mode sync|batch comes from the contract. Needs carmona_inference_tokens_total — NOT PUBLISHED YET (task A).",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 31},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 8, "showPoints": "never"},
          "color": {"mode": "palette-classic"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (mode, kind) (rate(carmona_inference_tokens_total[$__rate_interval]))", "legendFormat": "{{mode}} {{kind}} tok/s", "editorMode": "code", "range": true},
        {"refId": "B", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (outcome) (rate(carmona_inference_requests_total[$__rate_interval]))", "legendFormat": "requests/s {{outcome}}", "editorMode": "code", "range": true}
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Engine preemptions (5m)",
      "description": "Requests the engine evicted from its KV cache for lack of room; each is recomputed from the start. Straight from the engine's own vllm:num_preemptions_total (the simulator does not report it, so the panel is empty there). Nothing above 0 is the healthy reading; a sustained count means the KV cache is too small for the load (fewer slots, or more of the card's memory for the cache). A panel and not an alert until the first GPU day shows what normal is.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 31},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 8, "showPoints": "never"},
          "color": {"mode": "palette-classic"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (job) (increase(vllm:num_preemptions_total{job=~\"engine|vllm\"}[5m]))", "legendFormat": "preemptions {{job}}", "editorMode": "code", "range": true}
      ]
    }
  ]
}
