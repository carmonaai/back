{
  "uid": "carmona-red",
  "title": "Carmona — service RED (per service)",
  "description": "Rate, errors and duration for each of the eight services, from its own HTTP server metrics on the management port. One row of three panels repeats per service; pick services in the selector at the top.",
  "tags": ["carmona", "red"],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "job",
        "label": "service",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "query": {"query": "label_values(http_server_requests_seconds_count, job)", "refId": "service"},
        "definition": "label_values(http_server_requests_seconds_count, job)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "sort": 1,
        "current": {"selected": true, "text": ["All"], "value": ["$__all"]}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "RED per service — rate (requests/s), errors (5xx share), duration (p95)",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Rate — $job",
      "description": "Requests per second by route (the uri label, which is the mapped pattern, not the raw path). Traffic a service does not expect — a management-port scrape is the only request on an idle stack — is the first thing to look at when it changes.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "repeat": "job",
      "repeatDirection": "h",
      "maxPerRow": 3,
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 1},
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 8, "showPoints": "never"},
          "color": {"mode": "palette-classic"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (uri) (rate(http_server_requests_seconds_count{job=\"$job\"}[$__rate_interval]))", "legendFormat": "{{uri}}", "editorMode": "code", "range": true}
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Errors — $job",
      "description": "SLO: below 5% of requests (the line; the ErrorShareHigh alert fires above it for 5m). 5xx only: a 4xx here is a client mistake or a correct business answer (402 out of credit, 429 a refusal) and belongs to the revenue dashboard.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "repeat": "job",
      "repeatDirection": "h",
      "maxPerRow": 3,
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 1},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 8, "showPoints": "never"},
          "color": {"mode": "palette-classic"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.05}]}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (uri) (rate(http_server_requests_seconds_count{job=\"$job\", outcome=\"SERVER_ERROR\"}[5m])) / sum by (uri) (rate(http_server_requests_seconds_count{job=\"$job\"}[5m]))", "legendFormat": "{{uri}}", "editorMode": "code", "range": true}
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Duration — $job (max and mean)",
      "description": "No percentiles are available for the built-in HTTP metrics: Micrometer publishes no _bucket series for http_server_requests_seconds unless the service sets management.metrics.distribution.percentiles-histogram.http.server.requests, and that file belongs to another task. Until then this panel shows the slowest request in the interval (max) and the mean. No per-service latency SLO exists either: plan §8 sets SLOs per model class on the inference path, not per internal service. The red line at 15 s is the gateway's own response timeout; /v1 routes are exempt (660 s, streaming).",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "repeat": "job",
      "repeatDirection": "h",
      "maxPerRow": 3,
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 1},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 8, "showPoints": "never"},
          "color": {"mode": "palette-classic"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 15}]}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"refId": "max", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "max by (uri) (http_server_requests_seconds_max{job=\"$job\"})", "legendFormat": "{{uri}} max", "editorMode": "code", "range": true},
        {"refId": "mean", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (uri) (rate(http_server_requests_seconds_sum{job=\"$job\"}[$__rate_interval])) / sum by (uri) (rate(http_server_requests_seconds_count{job=\"$job\"}[$__rate_interval]))", "legendFormat": "{{uri}} mean", "editorMode": "code", "range": true}
      ]
    },
    {
      "id": 5,
      "type": "row",
      "title": "Gateway routes — public traffic is only visible here",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 8},
      "panels": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Gateway: routed requests/s by route",
      "description": "Spring Cloud Gateway sets no path pattern on the exchange, so http_server_requests_seconds labels every public request uri=\"UNKNOWN\" (the gateway row above, measured on 2026-10-05). Route-level RED comes from the gateway's own metric instead; its labels carry no personal data (routeId is the route name from application.yaml, routeUri the upstream). SLO: errors below 5% of routed requests — HTTP statuses are in the status tag, gateway-generated failures (SERVICE_UNAVAILABLE when the upstream or its circuit breaker refuses) in outcome=\"SERVER_ERROR\".",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 9},
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 8, "showPoints": "never"},
          "color": {"mode": "palette-classic"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": [
          {"matcher": {"id": "byRegexp", "options": ".*errors"}, "properties": [{"id": "custom.lineStyle", "value": {"dash": [10, 10], "fill": "dash"}}, {"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]}
        ]
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"refId": "rate", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (routeId) (rate(spring_cloud_gateway_requests_seconds_count{job=\"gateway\"}[$__rate_interval]))", "legendFormat": "{{routeId}}", "editorMode": "code", "range": true},
        {"refId": "errors", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (routeId, status) (rate(spring_cloud_gateway_requests_seconds_count{job=\"gateway\", outcome=\"SERVER_ERROR\"}[5m]))", "legendFormat": "{{routeId}} {{status}} errors", "editorMode": "code", "range": true}
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Gateway: routed request max by route",
      "description": "The same metric as duration: the slowest request the gateway saw per route (no _bucket series exists for it either, so max is what there is). /v1 streams for minutes by design — its route timeout is 660 s — so the 15 s line is meaningful for the other routes only.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 9},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 8, "showPoints": "never"},
          "color": {"mode": "palette-classic"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 15}]}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "max by (routeId) (spring_cloud_gateway_requests_seconds_max{job=\"gateway\"})", "legendFormat": "{{routeId}} max", "editorMode": "code", "range": true}
      ]
    }
  ]
}
