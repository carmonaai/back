+	"time"
+
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+	"github.com/soheilhy/cmux"
+	"github.com/valyala/fasthttp"
+	"k8s.io/klog/v2"
+
+	"github.com/llm-d/llm-d-inference-sim/pkg/api"
+	"github.com/llm-d/llm-d-inference-sim/pkg/common"
+	"github.com/llm-d/llm-d-inference-sim/pkg/simulator"
+	"github.com/llm-d/llm-d-inference-sim/pkg/tokenizer"
+)
+
+// slowServer runs a real simulator behind a real HTTP server on cmux, as main does: one slot, a queue of 4,
+// 300 ms before the first token and 20 ms per token, echo mode (the answer is as long as the prompt).
+func slowServer(ctx context.Context) (addr string, sim *simulator.Simulator) {
+	return slowServerWith(ctx, common.ModeEcho, "20ms")
+}
+
+// slowServerWith is slowServer with another mode (random is what makes tool calls), another time between tokens and
+// more flags.
+func slowServerWith(ctx context.Context, mode, interToken string, extra ...string) (addr string, sim *simulator.Simulator) {
+	oldArgs := os.Args
+	defer func() { os.Args = oldArgs }()
+	os.Args = append([]string{"cmd", "--model", common.TestModelName, "--mode", mode,
+		"--max-num-seqs=1", "--max-waiting-queue-length=4", "--latency-calculator=constant",
+		"--time-to-first-token=300ms", "--inter-token-latency=" + interToken}, extra...)
+	config, err := common.ParseCommandParamsAndLoadConfig()
+	Expect(err).NotTo(HaveOccurred())
+
+	sim, err = simulator.New(klog.Background())
+	Expect(err).NotTo(HaveOccurred())
+	sim.Context.SetConfig(config)
+	sim.Context.Tokenizer = tokenizer.NewSimpleTokenizer()
+	Expect(sim.InitializeSim(ctx)).To(Succeed())
+
+	listener, err := net.Listen("tcp4", "127.0.0.1:0")
+	Expect(err).NotTo(HaveOccurred())
+	m := cmux.New(listener)
+	m.SetReadTimeout(500 * time.Millisecond) // main sets 5 s; cmux puts a read deadline on every new connection
+	httpL := m.Match(cmux.Any())
+	go m.Serve()                                               //nolint:errcheck
+	go New(klog.Background(), sim).StartHTTPServer(ctx, httpL) //nolint:errcheck
+	DeferCleanup(func() { listener.Close() })                  //nolint:errcheck
+	return listener.Addr().String(), sim
+}
+
+// chatBody is a streaming chat request whose echoed answer is about words tokens long.
+func chatBody(words int, streamOptions string) string {
+	prompt := strings.TrimSpace(strings.Repeat("w ", words))
+	return fmt.Sprintf(`{"model":%q,"messages":[{"role":"user","content":%q}],"max_tokens":%d,"stream":true%s}`,
+		common.TestModelName, prompt, words*3, streamOptions)
+}
+
+// continuous is the stream_options that ask for the usage so far on every chunk.
+const continuous = `,"stream_options":{"include_usage":true,"continuous_usage_stats":true}`
+
+// toolsBody is a streaming chat request that must end in a call of get_weather.
+func toolsBody(streamOptions string) string {
+	return fmt.Sprintf(`{"model":%q,"messages":[{"role":"user","content":"weather in Recife?"}],"max_tokens":200,"stream":true,`+
+		`"tools":[{"type":"function","function":{"name":"get_weather","description":"Weather in a city","parameters":`+
+		`{"type":"object","properties":{"city":{"type":"string"},"unit":{"type":"string"}},"required":["city","unit"]}}}],`+
+		`"tool_choice":"required"%s}`, common.TestModelName, streamOptions)
+}
+
+// serverFor starts a slowServerWith that is stopped when the spec is over.
+func serverFor(mode, interToken string, extra ...string) (string, *simulator.Simulator) {
+	ctx, cancel := context.WithCancel(context.Background())
+	DeferCleanup(cancel)
+	return slowServerWith(ctx, mode, interToken, extra...)
+}
+
+// seen is one chunk of a streamed answer: its usage (nil if null), its choices and what they carry.
+type seen struct {
+	raw      string
+	usage    map[string]any
+	choices  int
+	content  string
+	finish   string
+	toolCall bool
+	modality string
+}
+
+// readChunks posts body (with headers given as "Name: value") and returns every chunk of the stream, [DONE] left out.
+func readChunks(addr, body string, headers ...string) []seen {
+	req, err := http.NewRequest(http.MethodPost, "http://"+addr+"/v1/chat/completions", strings.NewReader(body))
+	Expect(err).NotTo(HaveOccurred())
+	req.Header.Set("Content-Type", "application/json")
+	for _, h := range headers {
+		name, value, _ := strings.Cut(h, ": ")
+		req.Header.Set(name, value)
+	}
+	resp, err := http.DefaultClient.Do(req)
+	Expect(err).NotTo(HaveOccurred())
+	defer resp.Body.Close() //nolint:errcheck
+	var out []seen
+	sc := bufio.NewScanner(resp.Body)
+	sc.Buffer(make([]byte, 1<<20), 1<<20)
+	for sc.Scan() {
+		data, ok := strings.CutPrefix(sc.Text(), "data: ")
+		if !ok || data == "[DONE]" {
+			continue
+		}
+		var v struct {
+			Usage    map[string]any `json:"usage"`
+			Modality string         `json:"modality"`
+			Choices  []struct {
+				FinishReason *string `json:"finish_reason"`
+				Delta        struct {
+					Content   json.RawMessage `json:"content"`
+					ToolCalls []any           `json:"tool_calls"`
+				} `json:"delta"`
+			} `json:"choices"`
+		}
+		Expect(json.Unmarshal([]byte(data), &v)).To(Succeed())
+		c := seen{raw: data, usage: v.Usage, choices: len(v.Choices), modality: v.Modality}
+		if len(v.Choices) > 0 {
+			var text string
+			_ = json.Unmarshal(v.Choices[0].Delta.Content, &text) // an array in omni mode: not text
+			c.content = text
+			c.toolCall = len(v.Choices[0].Delta.ToolCalls) > 0
+			if v.Choices[0].FinishReason != nil {
+				c.finish = *v.Choices[0].FinishReason
+			}
+		}
+		out = append(out, c)
+	}
+	Expect(sc.Err()).NotTo(HaveOccurred())
+	return out
+}
+
+// send opens a connection and writes one chat request on it, without reading anything.
+func send(addr, body string) net.Conn {
+	conn, err := net.Dial("tcp", addr)
+	Expect(err).NotTo(HaveOccurred())
+	Expect(conn.SetDeadline(time.Now().Add(20 * time.Second))).To(Succeed()) // a wrongly cut request fails a spec, it does not hang it
+	_, err = fmt.Fprintf(conn, "POST /v1/chat/completions HTTP/1.1\r\nHost: sim\r\nContent-Type: application/json\r\n"+
+		"Content-Length: %d\r\n\r\n%s", len(body), body)
+	Expect(err).NotTo(HaveOccurred())
+	return conn
+}
+
+// readUntil reads from conn until marker has arrived, the connection ends or d is over.
+func readUntil(conn net.Conn, marker string, d time.Duration) string {
+	Expect(conn.SetReadDeadline(time.Now().Add(d))).To(Succeed())
+	var got strings.Builder
+	buf := make([]byte, 4096)
+	for !strings.Contains(got.String(), marker) {
+		n, err := conn.Read(buf)
+		got.Write(buf[:n])
+		if err != nil {
+			break
+		}
+	}
+	return got.String()
+}
+
+// metric sums a Prometheus series of the simulator over its label sets; lines must contain match.
+func metric(addr, name, match string) float64 {
+	resp, err := http.Get("http://" + addr + "/metrics")
+	Expect(err).NotTo(HaveOccurred())
+	defer resp.Body.Close() //nolint:errcheck
+	sum := 0.0
+	sc := bufio.NewScanner(resp.Body)
+	for sc.Scan() {
+		line := sc.Text()
+		if !strings.HasPrefix(line, name+"{") || !strings.Contains(line, match) {
+			continue
+		}
+		v, err := strconv.ParseFloat(line[strings.LastIndex(line, " ")+1:], 64)
+		Expect(err).NotTo(HaveOccurred())
+		sum += v
+	}
+	return sum
+}
+
+// inGoroutines counts the goroutines of this process that are inside the Communication method fn right now.
+func inGoroutines(fn string) int {
+	var dump bytes.Buffer
+	Expect(pprof.Lookup("goroutine").WriteTo(&dump, 2)).To(Succeed())
+	return strings.Count(dump.String(), "\ngithub.com/llm-d/llm-d-inference-sim/pkg/communication.(*Communication)."+fn+"(")
+}
+
+// testLink is a clientLink with no connection behind it: done already, or live until stop.
+func testLink(done bool) *clientLink {
+	l := &clientLink{}
+	l.ctx, l.cancel = context.WithCancel(context.Background())
+	if done {
+		l.stop()
+	}
+	return l
+}
+
+var _ = Describe("a client that hangs up", func() {
+	var (
+		addr string
+		sim  *simulator.Simulator
+	)
+	running := func() float64 { return metric(addr, "vllm:num_requests_running", "") }
+	waiting := func() float64 { return metric(addr, "vllm:num_requests_waiting", "") }
+	generated := func() float64 { return metric(addr, "vllm:generation_tokens_total", "") }
+	aborted := func() float64 { return metric(addr, "vllm:request_success_total", `finish_reason="abort"`) }
+	prompted := func() float64 { return metric(addr, "vllm:prompt_tokens_total", "") }
+
+	BeforeEach(func() {
+		ctx, cancel := context.WithCancel(context.Background())
+		DeferCleanup(cancel)
+		addr, sim = slowServer(ctx)
+	})
+
+	It("stops a running stream at its next token and counts only the tokens produced", func() {
+		conn := send(addr, chatBody(150, "")) // 150 tokens would take 3.3 s
+		br := bufio.NewReader(conn)
+		for { // read until the first content chunk, then hang up
+			line, err := br.ReadString('\n')
+			Expect(err).NotTo(HaveOccurred())
+			if strings.Contains(line, `"content":"`) {
+				break
+			}
+		}
+		Expect(running()).To(Equal(1.0))
+		Expect(conn.Close()).To(Succeed())
+
+		Eventually(running, "500ms", "20ms").Should(Equal(0.0)) // stock v0.11.4: still 1 after 3 s
+		Eventually(aborted, "500ms", "20ms").Should(Equal(1.0))
+		Expect(generated()).To(BeNumerically(">", 0), "the tokens produced before the hang-up are not counted")
+		Expect(generated()).To(BeNumerically("<", 40), "generation went on after the hang-up")
+		Expect(prompted()).To(BeNumerically(">", 150), "the processed prompt is not counted") // 150 words
+		Consistently(generated, "400ms", "100ms").Should(Equal(generated()))
+		Expect(sim.OpenRequests()).To(BeZero())
+	})
+
+	It("stops a request that is still waiting for its first token, and counts nothing for it", func() {
+		conn := send(addr, chatBody(150, ""))
+		Eventually(running, "300ms", "10ms").Should(Equal(1.0))
+		Expect(conn.Close()).To(Succeed()) // before the 300 ms of prefill are over
+
