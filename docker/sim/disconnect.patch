+// Carmona patch (docker/sim/disconnect.patch): a client that hangs up stops the generation, and
+// stream_options.continuous_usage_stats puts the usage so far on every chunk.
+
+package communication
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"os"
+	"runtime/pprof"
