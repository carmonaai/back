diff --git a/pkg/simulator/disconnect_test.go b/pkg/simulator/disconnect_test.go
new file mode 100644
index 0000000..d4f5b99
--- /dev/null
+++ b/pkg/simulator/disconnect_test.go
@@ -0,0 +1,85 @@
+/*
