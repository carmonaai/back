+// Carmona patch (docker/sim/disconnect.patch): the simulator learns that its client has gone.
+
+package communication
+
+import (
+	"context"
+	"net"
+	"time"
+
+	"github.com/llm-d/llm-d-inference-sim/pkg/api"
+	"github.com/llm-d/llm-d-inference-sim/pkg/simulator"
+)
+
+// statusClientClosedRequest is the 499 of nginx: the status of a request nobody waits for any more. Only logs see it.
+const statusClientClosedRequest = 499
+
+// clientPollEvery is how often a request that has written nothing yet looks at its connection. A stream that is
+// being written finds out at its next write; this covers the time in the queue and before the first token.
+// ponytail: a hang-up is found up to 25 ms late, so a cancelled request may produce a token or two more than the client
+// saw (the accounting tolerance H2/H3 use). Upgrade path: a smaller period (the cost is CPU per request in flight), or
+// the epoll loop named at watchClient.
+const clientPollEvery = 25 * time.Millisecond
+
+// clientLink ties one request to its client. ctx is done when the client has hung up, or when the response is
+// complete or has failed (cancel is called on every way out); the simulator stops generating for a done ctx.
+type clientLink struct {
+	ctx             context.Context
+	cancel          context.CancelFunc
+	continuousUsage bool
+}
+
+// continuousUsageRequester is implemented by the completion requests that carry stream_options.
+// ponytail: continuous usage is for the chat chunks of /v1/chat/completions only (the one endpoint inference-service
+// uses); /v1/responses and /v1/messages requests do not implement this and /v1/completions chunks are not stamped.
+// Upgrade: implement it on those request types and teach stamp their chunk types.
+type continuousUsageRequester interface{ ContinuousUsageStats() bool }
+
+func newClientLink(req simulator.Request) *clientLink {
+	ctx, cancel := context.WithCancel(context.Background())
+	cu, _ := req.(continuousUsageRequester)
+	return &clientLink{ctx: ctx, cancel: cancel, continuousUsage: cu != nil && cu.ContinuousUsageStats()}
+}
+
+// gone reports that the client hung up (or the request is over).
+func (l *clientLink) gone() bool { return l.ctx.Err() != nil }
+
+// stop ends the request: the client is gone, or the response is complete.
+func (l *clientLink) stop() { l.cancel() }
+
+// watchClient cancels the request once the client's connection is closed or reset, until the request is over.
+// fasthttp tells a handler nothing about the connection while it runs, and a request that is waiting in the
+// queue or being prefilled writes nothing, so the socket is looked at (peerGone) every clientPollEvery.
+// ponytail: one goroutine and one 25 ms poll per request in flight (the engine runs a dozen at a time). Upgrade
+// path if that ever matters: one epoll loop over all sockets, or a read-side wrapper on the connection.
+func (c *Communication) watchClient(conn net.Conn, link *clientLink) {
+	t := time.NewTicker(clientPollEvery) // no Stop: go.mod says go 1.26, which collects an unreferenced ticker
+	for {
+		select {
+		case <-link.ctx.Done():
+			return
+		case <-t.C:
+			if peerGone(conn) {
+				link.cancel() // the next turn of the loop sees ctx.Done and returns
+			}
+		}
+	}
+}
+
+// stamp puts the usage so far on a chat chunk when the client asked for continuous_usage_stats (a vLLM extension:
+// the first, role chunk has the prompt tokens and 0 completion tokens; every later chunk the tokens sent so far).
+func (st *streamState) stamp(chunk sseChunk) sseChunk {
+	if !st.continuousUsage {
+		return chunk
+	}
+	j, ok := chunk.(*jsonDataChunk)
+	if !ok {
+		return chunk
+	}
+	var cc *api.ChatCompletionsRespChunk
+	switch v := j.data.(type) { // createChunk boxes a pointer in a pointer
+	case *api.ChatCompletionsRespChunk:
+		cc = v
+	case **api.ChatCompletionsRespChunk:
+		cc = *v
+	}
+	if cc != nil {
+		cc.Usage = &api.Usage{
+			PromptTokens:        st.prompt.PromptTokens,
+			CompletionTokens:    st.completion,
+			TotalTokens:         st.prompt.PromptTokens + st.completion,
+			PromptTokensDetails: st.prompt.PromptTokensDetails,
+		}
+	}
+	return chunk
+}
