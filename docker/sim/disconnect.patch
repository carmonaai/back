+var _ = Describe("peerGone", func() {
+	// look runs peerGone and fails the spec if it blocks: it must never wait for the socket
+	look := func(conn net.Conn) bool {
+		res := make(chan bool, 1)
+		go func() {
+			defer GinkgoRecover() // a panic in peerGone fails this spec, it does not end the run
+			res <- peerGone(conn)
+		}()
+		var gone bool
+		Eventually(res, "1s").Should(Receive(&gone))
+		return gone
+	}
+
+	It("is false for a connection whose client is there and silent, and does not block on it", func() {
+		server, _ := tcpPair()
+		Expect(look(server)).To(BeFalse())
+	})
+
+	It("is false while the client has sent something, and does not consume it", func() {
+		server, client := tcpPair()
+		_, err := client.Write([]byte("x"))
+		Expect(err).NotTo(HaveOccurred())
+		time.Sleep(100 * time.Millisecond) // on loopback it has arrived long before this
+		Expect(look(server)).To(BeFalse())
+		Expect(look(server)).To(BeFalse())
+		Expect(server.SetReadDeadline(time.Now().Add(time.Second))).To(Succeed())
+		buf := make([]byte, 1)
+		n, err := server.Read(buf)
+		Expect(err).NotTo(HaveOccurred())
+		Expect(n).To(Equal(1), "the byte was consumed by the look")
+	})
+
+	It("is true once the client has closed its side", func() {
+		server, client := tcpPair()
+		Expect(client.Close()).To(Succeed())
+		Eventually(func() bool { return look(server) }, "1s", "10ms").Should(BeTrue())
+	})
+
+	It("is true once the client has reset the connection", func() {
+		server, client := tcpPair()
+		Expect(client.SetLinger(0)).To(Succeed()) // close sends a RST, not a FIN
+		Expect(client.Close()).To(Succeed())
+		time.Sleep(100 * time.Millisecond) // on loopback it has arrived long before this
+		// the first look after a reset gets ECONNRESET (the next ones get "closed"): the error itself must say "gone"
+		Expect(look(server)).To(BeTrue())
+	})
+
