+// tcpPair returns a connected pair: the server's side of a connection, and the client's.
+func tcpPair() (server, client *net.TCPConn) {
+	l, err := net.Listen("tcp4", "127.0.0.1:0")
+	Expect(err).NotTo(HaveOccurred())
+	defer l.Close() //nolint:errcheck
+	dialed := make(chan *net.TCPConn, 1)
+	go func() {
+		c, err := net.Dial("tcp4", l.Addr().String())
+		if err != nil {
+			dialed <- nil
+			return
+		}
+		dialed <- c.(*net.TCPConn)
+	}()
+	accepted, err := l.Accept()
+	Expect(err).NotTo(HaveOccurred())
+	client = <-dialed
+	Expect(client).NotTo(BeNil())
+	DeferCleanup(func() { accepted.Close(); client.Close() }) //nolint:errcheck
+	return accepted.(*net.TCPConn), client
+}
