+// dropWaiting takes a request out of the waiting queue because its client has gone. A request that a worker
+// already took is not in the queue; the worker stops it (processRequest).
+func (s *Simulator) dropWaiting(reqCtx requestContext) {
+	s.queueLock.Lock()
+	found := false
+	for elem := s.waitingQueue.Front(); elem != nil; elem = elem.Next() {
+		if elem.Value.(waitingQueueItem).reqCtx == reqCtx { // the queue holds nothing else
+			s.waitingQueue.Remove(elem) // clears elem.next: the loop ends here
+			found = true
+		}
+	}
+	s.queueLock.Unlock()
+	if !found {
+		return
+	}
+	common.WriteToChannel(s.Context.metrics.waitingReqChan, common.MetricInfo{Value: -1}, s.Context.logger)
+	if model := reqCtx.request().GetDisplayedModel(); s.Context.isLora(model) {
+		common.WriteToChannel(s.Context.metrics.lorasChan, loraUsage{model, droppedUsageState}, s.Context.logger)
+	}
+	// no response was produced: signalDone lets the response channel close
+	reqCtx.signalDone()
