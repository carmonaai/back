+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+// Carmona patch (docker/sim/disconnect.patch): the simulated sleeps and the waiting queue follow the client.
+// The end-to-end specs of a hang-up are in pkg/communication/disconnect_test.go.
+
+package simulator
+
+import (
+	"context"
+	"sync"
+	"time"
+
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("sleepCtx", func() {
+	// ask runs sleepCtx and fails the spec if it does not return within a second (a wrong one would sleep for d)
+	ask := func(ctx context.Context, d time.Duration) bool {
+		res := make(chan bool, 1)
+		go func() { res <- sleepCtx(ctx, d) }()
+		var ok bool
+		Eventually(res, "1s").Should(Receive(&ok))
+		return ok
+	}
+
+	It("is false at once for a context that is done, whatever the delay", func() {
+		ctx, cancel := context.WithCancel(context.Background())
+		cancel()
+		Expect(ask(ctx, time.Hour)).To(BeFalse())
+	})
+
+	It("is false as soon as the context is done while it waits", func() {
+		ctx, cancel := context.WithCancel(context.Background())
+		time.AfterFunc(30*time.Millisecond, cancel)
+		Expect(ask(ctx, time.Hour)).To(BeFalse())
+	})
+
+	It("waits the whole delay on a context that stays live, and is true", func() {
+		start := time.Now()
+		Expect(ask(context.Background(), 40*time.Millisecond)).To(BeTrue())
+		Expect(time.Since(start)).To(BeNumerically(">=", 40*time.Millisecond))
+		Expect(ask(context.Background(), 0)).To(BeTrue())
+	})
+})
+
+var _ = Describe("a waiting request whose client leaves", func() {
+	count := func(m *sync.Map) (n int) {
+		m.Range(func(_, _ any) bool { n++; return true })
+		return n
+	}
+
+	It("leaves waiting_lora_adapters, and running_lora_adapters is not touched", func() {
+		sim := newHandleRequestTestSim(context.Background(), 4, "--lora-modules", `{"name":"lora1","path":"/path/to/lora1"}`)
+		sim.queueCapacity = 4 // InitializeSim sets it, and the test sim skips that
+		ctx, cancel := context.WithCancel(context.Background())
+		DeferCleanup(cancel)
+		req := newTextCompletionsRequestWithChoices("lora-wait", 1)
+		req.Model = "lora1"
+		_, _, respChan, topErr, _ := sim.HandleRequestCtx(ctx, req)
+		Expect(topErr).To(BeNil())
+		sim.addRequestToQueue(<-sim.newRequests.Channel) // no worker takes it: it waits
+
+		Eventually(func() int { return count(&sim.Context.metrics.waitingLoras) }, "1s", "10ms").Should(Equal(1))
+		cancel()
+
+		Eventually(respChan.Channel, "1s").Should(BeClosed()) // dropWaiting signalled done
+		Eventually(func() int { return count(&sim.Context.metrics.waitingLoras) }, "1s", "10ms").Should(BeZero())
+		Expect(count(&sim.Context.metrics.runningLoras)).To(BeZero())
+	})
+})
