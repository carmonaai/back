+import (
+	"errors"
+	"net"
+	"os"
+	"syscall"
+
+	"github.com/soheilhy/cmux"
+)
+
+// peerGone looks at the socket without reading from it (MSG_PEEK, so no byte is consumed; Go makes every socket it
+// opens non-blocking, so the recv never waits either): zero bytes means the client closed its side, an error other than "nothing yet" means the
+// connection is broken or was closed here. A connection that has no socket to look at (TLS) is never "gone":
+// the next write finds out.
+// ponytail: Linux only (conncheck_other.go); peeking after a TLS handshake would need the underlying socket.
+func peerGone(conn net.Conn) bool {
+	if mc, ok := conn.(*cmux.MuxConn); ok { // the listener is cmux's: the socket is inside
+		conn = mc.Conn
+	}
+	sc, ok := conn.(syscall.Conn)
+	if !ok {
+		return false
+	}
+	raw, err := sc.SyscallConn()
+	if err != nil {
+		return false // cannot look: not gone, a healthy request must never be cut on a doubt
+	}
+	var (
+		n    int
+		rerr error
+		buf  [1]byte
+	)
+	if err := raw.Read(func(fd uintptr) bool {
+		n, _, rerr = syscall.Recvfrom(int(fd), buf[:], syscall.MSG_PEEK)
+		return true // never wait for readability: this is a poll
+	}); err != nil {
+		// RawRead refuses while a read deadline has passed (cmux sets one while it sniffs a new connection): that is
+		// not a hang-up. Anything else (the connection is closed here) is the end of the request either way.
+		return !errors.Is(err, os.ErrDeadlineExceeded)
+	}
+	switch rerr {
+	case nil:
+		return n == 0
+	case syscall.EAGAIN: // nothing to read yet (a non-blocking recv is never interrupted, so no EINTR)
+		return false
+	default:
+		return true
+	}
+}
