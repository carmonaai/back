index 6436912..83766b7 100644
--- a/pkg/communication/response_builder.go
+++ b/pkg/communication/response_builder.go
@@ -242,7 +242,39 @@ func (*textComplHTTPRespBuilder) createRenderResponse(tokens [][]uint32,
 
 var _ responseBuilder = (*textComplHTTPRespBuilder)(nil)
 
-type chatComplHTTPRespBuilder struct{ baseRespBuilder }
+type chatComplHTTPRespBuilder struct {
+	baseRespBuilder
+	// metrics adds the per-request timing report (--enable-per-request-metrics) to the whole answer and to the final
+	// usage chunk (carmona patch, docker/sim/report.patch)
+	// ponytail: chat completions only, the one endpoint inference-service uses; the other builders send none.
+	// Upgrade: the Metrics field on their response types and the same call in their builders.
+	metrics bool
+}
+
+// timingReport is vLLM's per-request timing report of an answer: the times the simulator measured, in milliseconds.
+// vLLM sends none for n > 1, and a mean_itl_ms only for more than one output token.
+func timingReport(respCtxPerChoice []simulator.ResponseContext) *api.RequestMetrics {
+	if len(respCtxPerChoice) != 1 {
+		return nil
+	}
+	respCtx := respCtxPerChoice[0]
+	times := respCtx.Times()
+	tokens := respCtx.UsageData().CompletionTokens
+	ms := func(d time.Duration) float64 { return float64(d) / float64(time.Millisecond) }
+	report := &api.RequestMetrics{
+		QueueTimeMs:        ms(times.Queue),
+		TimeToFirstTokenMs: ms(times.Prefill),
+		GenerationTimeMs:   ms(times.Generation),
+	}
+	if tokens > 1 {
+		itl := ms(times.Generation) / float64(tokens-1)
+		report.MeanItlMs = &itl
+	}
+	if scheduled := times.Prefill + times.Generation; scheduled > 0 { // vLLM counts from scheduling, not from the queue
+		report.TokensPerSecond = float64(tokens) / scheduled.Seconds()
+	}
+	return report
+}
 
