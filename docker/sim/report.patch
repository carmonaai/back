+// Carmona patch (docker/sim/report.patch): the engine's per-request timing report, as vLLM sends it with
+// --enable-per-request-metrics. The helpers of disconnect_test.go (serverFor, metric, chatBody) are used here.
+
+package communication
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"strings"
+	"time"
+
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+
+	"github.com/llm-d/llm-d-inference-sim/pkg/api"
+	"github.com/llm-d/llm-d-inference-sim/pkg/common"
+	"github.com/llm-d/llm-d-inference-sim/pkg/simulator"
+)
+
+const reportFlag = "--enable-per-request-metrics"
+
+// the five fields of the report: milliseconds on the engine's clock, tokens_per_second per second
+var reportFields = []string{"queue_time_ms", "time_to_first_token_ms", "generation_time_ms", "mean_itl_ms", "tokens_per_second"}
+
+// wholeAnswer posts a chat request that is not streamed (an echoed answer of about words tokens, plus extra json fields)
+// and returns the answer as it arrived and decoded.
+func wholeAnswer(addr string, words int, extra string) (string, map[string]any) {
+	body := fmt.Sprintf(`{"model":%q,"messages":[{"role":"user","content":%q}],"max_tokens":%d%s}`,
+		common.TestModelName, strings.TrimSpace(strings.Repeat("w ", words)), words*3+10, extra)
+	resp, err := http.Post("http://"+addr+"/v1/chat/completions", "application/json", strings.NewReader(body))
+	Expect(err).NotTo(HaveOccurred())
+	defer resp.Body.Close() //nolint:errcheck
+	data, err := io.ReadAll(resp.Body)
+	Expect(err).NotTo(HaveOccurred())
+	Expect(resp.StatusCode).To(Equal(http.StatusOK), string(data))
+	var v map[string]any
+	Expect(json.Unmarshal(data, &v)).To(Succeed())
+	return string(data), v
+}
+
+// arrived is a streamed chunk, decoded, with the time it reached the client.
+type arrived struct {
+	v  map[string]any
+	at time.Time
+}
+
+// streamed posts a streaming chat request and returns every chunk, [DONE] left out.
+func streamed(addr, body string) []arrived {
+	resp, err := http.Post("http://"+addr+"/v1/chat/completions", "application/json", strings.NewReader(body))
+	Expect(err).NotTo(HaveOccurred())
+	defer resp.Body.Close() //nolint:errcheck
+	var out []arrived
+	sc := bufio.NewScanner(resp.Body)
+	sc.Buffer(make([]byte, 1<<20), 1<<20)
+	for sc.Scan() {
+		data, ok := strings.CutPrefix(sc.Text(), "data: ")
+		if !ok || data == "[DONE]" {
+			continue
+		}
+		var v map[string]any
+		Expect(json.Unmarshal([]byte(data), &v)).To(Succeed())
+		out = append(out, arrived{v, time.Now()})
+	}
+	Expect(sc.Err()).NotTo(HaveOccurred())
+	return out
+}
+
+// reportOf is the "metrics" object of an answer or chunk, nil when it has none.
+func reportOf(v map[string]any) map[string]any {
+	m, _ := v["metrics"].(map[string]any)
+	return m
+}
+
+// completionTokens is what the usage of an answer or chunk says the engine generated.
+func completionTokens(v map[string]any) float64 {
+	return v["usage"].(map[string]any)["completion_tokens"].(float64)
+}
+
+// contentOf is the text a chunk carries, "" for a chunk with none.
+func contentOf(v map[string]any) string {
+	choices, _ := v["choices"].([]any)
+	if len(choices) == 0 {
+		return ""
+	}
+	delta, _ := choices[0].(map[string]any)["delta"].(map[string]any)
+	text, _ := delta["content"].(string)
+	return text
+}
+
+// theFive fails the spec unless m holds the five fields as json numbers (except mean_itl_ms, which has one more rule).
+func theFive(m map[string]any, withMeanItl bool) {
+	want := len(reportFields)
+	for _, f := range reportFields {
+		if f == "mean_itl_ms" && !withMeanItl {
+			Expect(m).NotTo(HaveKey(f))
+			want--
+			continue
+		}
+		Expect(m).To(HaveKey(f))
+		Expect(m[f]).To(BeAssignableToTypeOf(float64(0)), f+" is a json number")
+	}
+	Expect(m).To(HaveLen(want), "nothing else is in it")
+}
+
+// timeless is an answer that has no time at all to count, as one that never waited for a first token has (the immediate
+// return of a cache_threshold request); the embedded interface is nil, only these two methods are called.
+type timeless struct{ simulator.ResponseContext }
+
+func (timeless) Times() *simulator.EngineTimes { return &simulator.EngineTimes{} }
+func (timeless) UsageData() *api.Usage         { return &api.Usage{CompletionTokens: 5} }
+
+// the engine of slowServerWith: 300 ms of prefill, 20 ms between tokens, one slot
+var _ = Describe("the per-request timing report", func() {
+	withStream := `,"stream_options":{"include_usage":true}`
+
+	It("aFlagThatIsOffSendsNoMetrics", func() {
+		addr, _ := serverFor(common.ModeEcho, "20ms")
+
+		raw, _ := wholeAnswer(addr, 5, "")
+		Expect(raw).NotTo(ContainSubstring("metrics"))
+
+		chunks := streamed(addr, chatBody(5, withStream))
+		Expect(chunks[len(chunks)-1].v["usage"]).NotTo(BeNil(), "the usage chunk is there")
+		for _, c := range chunks {
+			Expect(reportOf(c.v)).To(BeNil())
+		}
+	})
+
+	It("aWholeAnswerCarriesTheFiveFieldsInMilliseconds", func() {
+		addr, _ := serverFor(common.ModeEcho, "20ms", reportFlag)
+
+		_, v := wholeAnswer(addr, 20, "")
+		m := reportOf(v)
+		Expect(m).NotTo(BeNil())
+		theFive(m, true)
+		tokens := completionTokens(v)
+		Expect(tokens).To(BeNumerically(">", 1))
+		ttft, gen := m["time_to_first_token_ms"].(float64), m["generation_time_ms"].(float64)
+
+		Expect(m["queue_time_ms"]).To(BeNumerically("<", 100), "a worker was free")
+		Expect(ttft).To(BeNumerically(">=", 300), "the prefill is the first-token delay, 300 ms, in ms")
+		Expect(ttft).To(BeNumerically("<", 450))
+		Expect(gen).To(BeNumerically(">=", (tokens-1)*20), "the sleeps between the tokens are never shorter than asked")
+		Expect(gen).To(BeNumerically("<", (tokens-1)*20+200))
+		// the formulas of vLLM, from the same two durations
+		Expect(m["mean_itl_ms"]).To(BeNumerically("~", gen/(tokens-1), 1e-6))
+		Expect(m["tokens_per_second"]).To(BeNumerically("~", tokens/((ttft+gen)/1000), 1e-6))
+	})
+
+	It("theFinalUsageChunkCarriesThemAndTheChunksBeforeItDoNot", func() {
+		addr, _ := serverFor(common.ModeEcho, "20ms", reportFlag)
+
+		// continuous_usage_stats puts the usage on every chunk: the report is still on the last one only
+		chunks := streamed(addr, chatBody(10, `,"stream_options":{"include_usage":true,"continuous_usage_stats":true}`))
+		Expect(len(chunks)).To(BeNumerically(">", 10))
+		last := chunks[len(chunks)-1].v
+		Expect(last["choices"]).To(BeEmpty(), "the final usage chunk has no choices")
+		m := reportOf(last)
+		Expect(m).NotTo(BeNil())
+		theFive(m, true)
+		Expect(m["generation_time_ms"]).To(BeNumerically(">", 0), "it is known before the last token is sent")
+		for _, c := range chunks[:len(chunks)-1] {
+			Expect(reportOf(c.v)).To(BeNil())
+		}
+
+		// a stream that did not ask for the usage has no final usage chunk, so no report either
+		for _, c := range streamed(addr, chatBody(5, "")) {
+			Expect(reportOf(c.v)).To(BeNil())
+		}
+	})
+
+	It("meanItlIsLeftOutForOneOutputToken", func() {
+		addr, _ := serverFor(common.ModeEcho, "20ms", reportFlag)
+
+		_, v := wholeAnswer(addr, 1, "")
+		Expect(completionTokens(v)).To(Equal(1.0))
+		m := reportOf(v)
+		Expect(m).NotTo(BeNil())
+		theFive(m, false)
+		Expect(m["generation_time_ms"]).To(BeNumerically("<", 5), "the first token is the last")
+		Expect(m["tokens_per_second"]).To(BeNumerically(">", 0))
+	})
+
+	It("nGreaterThanOneSendsNone", func() {
+		addr, _ := serverFor(common.ModeEcho, "20ms", reportFlag)
+
+		raw, v := wholeAnswer(addr, 3, `,"n":2`)
+		Expect(v["choices"]).To(HaveLen(2))
+		Expect(raw).NotTo(ContainSubstring("metrics"))
+
+		chunks := streamed(addr, chatBody(3, `,"n":2,"stream_options":{"include_usage":true}`))
+		Expect(chunks[len(chunks)-1].v["usage"]).NotTo(BeNil(), "the usage chunk is there")
+		for _, c := range chunks {
+			Expect(reportOf(c.v)).To(BeNil())
+		}
+	})
+
+	It("theTokensPerSecondOfARequestWithNoTimeIsZeroAndNotInfinite", func() {
+		m := timingReport([]simulator.ResponseContext{timeless{}})
+		Expect(m.TokensPerSecond).To(BeZero())
+		_, err := json.Marshal(m) // an infinite number would be no json at all
+		Expect(err).NotTo(HaveOccurred())
+	})
+
+	It("theQueueTimeIsTheWaitOfARequestThatWaited", func() {
+		addr, _ := serverFor(common.ModeEcho, "20ms", reportFlag)
+
+		firstDone := make(chan map[string]any, 1)
+		go func() { // takes the only slot for about 1.1 s
+			defer GinkgoRecover()
+			_, v := wholeAnswer(addr, 40, "")
+			firstDone <- v
+		}()
+		Eventually(func() float64 { return metric(addr, "vllm:num_requests_running", "") }, "2s", "10ms").Should(Equal(1.0))
+		_, second := wholeAnswer(addr, 5, "") // waits for the first to end
+		first := <-firstDone
+
+		Expect(reportOf(first)["queue_time_ms"]).To(BeNumerically("<", 100), "it did not wait")
+		Expect(reportOf(second)["queue_time_ms"]).To(BeNumerically(">=", 600), "it waited for the first")
+		Expect(reportOf(second)["queue_time_ms"]).To(BeNumerically("<", 1500))
+		Expect(reportOf(second)["time_to_first_token_ms"]).To(BeNumerically("<", 450), "the wait is not in the prefill")
+	})
+
+	It("theGenerationTimeIsFirstTokenToLastToken", func() {
+		addr, _ := serverFor(common.ModeEcho, "20ms", reportFlag)
+
+		chunks := streamed(addr, chatBody(20, withStream))
+		var first, last time.Time
+		for _, c := range chunks {
+			if contentOf(c.v) != "" {
+				if first.IsZero() {
+					first = c.at
+				}
+				last = c.at
+			}
+		}
+		final := chunks[len(chunks)-1].v
+		gen := reportOf(final)["generation_time_ms"].(float64)
+		sawMs := float64(last.Sub(first)) / float64(time.Millisecond)
+
+		Expect(gen).To(BeNumerically("~", sawMs, 100), "what the client saw between its first and its last token")
+		Expect(gen).To(BeNumerically("<", (completionTokens(final)-1)*20+200), "the prefill is not in it")
+	})
+})
