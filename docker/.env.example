# Copy to .env (untracked) and fill in. No defaults anywhere: compose refuses to start without these.
DB_NAME=carmona
DB_USER=carmona
# openssl rand -base64 24
DB_PASSWORD=
# RSA private key, base64 PKCS#8 DER on one line (the PEM body, without header lines):
# openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | grep -v -- ----- | tr -d '\r\n'
JWT_PRIVATE_KEY=
# openssl rand -hex 24 (Valkey: the API-key lookup cache)
VALKEY_PASSWORD=
# openssl rand -hex 24 (inference-service -> model engine)
ENGINE_API_KEY=
# openssl rand -hex 24 (inference-service -> vLLM; only with compose.gpu.yaml)
VLLM_API_KEY=
# openssl rand -base64 18 (Grafana admin, user "admin"; the dashboard port is never published)
GRAFANA_ADMIN_PASSWORD=

# resend api key used for sending emails
RESEND_API_KEY=

# Object storage for batch-service's files (compose.minio.yaml; smoke.sh needs it for the batch section).
# openssl rand -hex 12 each; the bucket name is not a secret. STORAGE_* is the bucket-scoped user batch-service gets,
# MINIO_ROOT_* stays with MinIO (the secret needs at least 8 characters).
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
STORAGE_BUCKET=batch-files
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
